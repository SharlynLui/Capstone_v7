--- !u!114 &1199218375
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1199218374}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ad566d5b34cf9c048b9e084843e3e3e0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  Steps:
  - InstructionText: Intro
    HighlightTarget: {fileID: 442702123}
    ArrowPosition: {x: 0, y: 0, z: 0}
    ArrowRotation: {x: 0, y: 0, z: 90}
    IsCheatModeStep: 0
    IsPracticeIntro: 0
    HideArrow: 1
  - InstructionText: These Orbs track your body's joints in real-time. As you move,
      the Orbs will change color according to your synchronization with Shifu. Your
      goal is to keep them Blue by matching Shifu's posture as closely as possible.
    HighlightTarget: {fileID: 0}
    ArrowPosition: {x: 0, y: 0, z: 0}
    ArrowRotation: {x: 0, y: 0, z: -90}
    IsCheatModeStep: 0
    IsPracticeIntro: 0
    HideArrow: 1
  - InstructionText: This is your Overall Score. Watch this to see how well you are
      performing the Tai Chi move!
    HighlightTarget: {fileID: 442702123}
    ArrowPosition: {x: 311, y: 549, z: 0}
    ArrowRotation: {x: 0, y: 0, z: 90}
    IsCheatModeStep: 0
    IsPracticeIntro: 0
    HideArrow: 0
  - InstructionText: Use the Menu Icon to return to the main screen.
    HighlightTarget: {fileID: 1779514764}
    ArrowPosition: {x: 365, y: -687, z: 0}
    ArrowRotation: {x: 0, y: 0, z: -90}
    IsCheatModeStep: 0
    IsPracticeIntro: 0
    HideArrow: 0
  - InstructionText: 'Tap the Cheat Icon to open the Settings Panel. You can customize
      two main areas to change how the game feels:  Orb Tolerance: Lower this to
      make the Orbs stay Green longer. This gives you more "breathing room" before
      they turn Red.  Effect Sensitivity: Decide how perfect your pose must be to
      trigger special visual effects.'
    HighlightTarget: {fileID: 1775620973}
    ArrowPosition: {x: 246, y: -687, z: 0}
    ArrowRotation: {x: 0, y: 0, z: -90}
    IsCheatModeStep: 1
    IsPracticeIntro: 0
    HideArrow: 0
  - InstructionText: The Debug Icon toggles the Data Overlay. This panel is designed
      for advanced users and developers to monitor the live system performance.
    HighlightTarget: {fileID: 353911471}
    ArrowPosition: {x: 126, y: -687, z: 0}
    ArrowRotation: {x: 0, y: 0, z: -90}
    IsCheatModeStep: 1
    IsPracticeIntro: 0
    HideArrow: 0
  - InstructionText: <color=#FFD700><size=120%>READY TO START?</size></color>\n\nMatch
      the master's pose now. The tutorial will automatically finish once you hit
      60% Accuracy.
    HighlightTarget: {fileID: 0}
    ArrowPosition: {x: 0, y: -1000, z: 0}
    ArrowRotation: {x: 0, y: 0, z: -90}
    IsCheatModeStep: 0
    IsPracticeIntro: 1
    HideArrow: 1
  TutorialPanel: {fileID: 1485585570}
  InstructionText: {fileID: 394140932}
  StepCounterText: {fileID: 1500923682}
  NextButton: {fileID: 1739076607}
  CancelButton: {fileID: 1584949896}
  ArrowImage: {fileID: 997695431}
  ScoreThreshold: 0.6
  ArrowMoveDuration: 0.3
